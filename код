#include <iostream>
#include <fstream>
#include <string>
#include <ctime>

using namespace std;

struct Worker {
	char Fam[50];
	char Name[50];
	char Otch[50];
	char workshop[50];
	int quantity;
	char category;
};

string generateFam() {
	string Fam[] = { "Ivanov", "Petrov", "Sidorov", "Kuznetsov", "Sokolov", "Mikhailov", "Fedorov", "Morozov" };
	return Fam[rand() % 8];
}

string generateName() {
	string Name[] = { "Alexey", "Dmitry", "Vladimir", "Sergey", "Andrey", "Ivan", "Maxim", "Egor" };
	return Name[rand() % 8];
}

string generateOtch() {
	string Otch[] = { "Alexeyevich", "Dmitrievich", "Vladimirovich", "Sergeevich", "Andreevich", "Ivanovich", "Maximovich", "Egorovich" };
	return Otch[rand() % 8];
}

string generateWorkshop() {
	string workshops[] = { "Цех №1", "Цех №2", "Цех №3", "Цех №4", "Цех №5" };
	return workshops[rand() % 5];
}

char generateCategory() {
	char categories[] = { 'A', 'B', 'C' };
	return categories[rand() % 3];
}

void generateRecord(Worker& x) {
	string fam = generateFam();
	string name = generateName();
	string otch = generateOtch();
	string workshop = generateWorkshop();

	for (size_t i = 0; i < fam.length() && i < 49; i++) {
		x.Fam[i] = fam[i];
	}
	x.Fam[fam.length()] = '\0';

	for (size_t i = 0; i < name.length() && i < 49; i++) {
		x.Name[i] = name[i];
	}
	x.Name[name.length()] = '\0';

	for (size_t i = 0; i < otch.length() && i < 49; i++) {
		x.Otch[i] = otch[i];
	}
	x.Otch[otch.length()] = '\0';

	for (size_t i = 0; i < workshop.length() && i < 49; i++) {
		x.workshop[i] = workshop[i];
	}
	x.workshop[workshop.length()] = '\0';

	x.quantity = rand() % 100 + 1;
	x.category = generateCategory();
}

void oneWorker(const Worker& w, int index) {
	cout << index + 1 << ". "
		<< w.Fam << " " << w.Name << " " << w.Otch
		<< ", Цех: " << w.workshop
		<< ", Количество: " << w.quantity
		<< ", Категория: " << w.category << endl;
}

void vivodAll(Worker* workers, int size) {
	if (size == 0) {
		cout << "Нет записей!" << endl;
		return;
	}
	cout << "\n========== ВСЕ ЗАПИСИ ==========" << endl;
	for (int i = 0; i < size; i++) {
		oneWorker(workers[i], i);
	}
	cout << "=================================" << endl;
}

void deleteRecord(Worker*& workers, int& size, int index) {
	if (index < 0 || index >= size) {
		cout << "Неверный индекс!" << endl;
		return;
	}

	Worker* new_workers = new Worker[size - 1];

	for (int i = 0; i < index; i++) {
		new_workers[i] = workers[i];
	}

	for (int i = index + 1; i < size; i++) {
		new_workers[i - 1] = workers[i];
	}

	delete[] workers;
	workers = new_workers;
	size--;

	cout << "Запись удалена!" << endl;
}

void searchByFam(Worker* workers, int size, const string& searchFam) {
	bool found = false;
	cout << "\n========== РЕЗУЛЬТАТЫ ПОИСКА ==========" << endl;
	for (int i = 0; i < size; i++) {
		string fam(workers[i].Fam);
		if (fam == searchFam) {
			oneWorker(workers[i], i);
			found = true;
		}
	}
	if (!found) {
		cout << "Рабочий с фамилией \"" << searchFam << "\" не найден!" << endl;
	}
	cout << "=========================================" << endl;
}

void sortRecords(Worker* workers, int size) {
	if (size <= 1) return;

	for (int i = 0; i < size - 1; i++) {
		for (int j = 0; j < size - i - 1; j++) {
			if (workers[j].quantity > workers[j + 1].quantity) {
				swap(workers[j], workers[j + 1]);
			}
		}
	}
	cout << "Сортировка по количеству изделий выполнена!" << endl;
}

void addRecords(Worker*& workers, int& size, int addSize) {
	if (addSize <= 0) {
		cout << "Количество записей должно быть больше 0!" << endl;
		return;
	}

	Worker* new_workers = new Worker[size + addSize];

	for (int i = 0; i < size; i++) {
		new_workers[i] = workers[i];
	}

	for (int i = 0; i < addSize; i++) {
		generateRecord(new_workers[size + i]);
	}

	delete[] workers;
	workers = new_workers;
	size += addSize;
	cout << "Добавлено " << addSize << " записей! Всего: " << size << endl;
}

void save(const string& filename, Worker* workers, int size) {
	string path = "D:\\333\\";
	string file = path + filename;
	fstream f;

	f.open(file, ios_base::out | ios_base::binary);

	if (f.is_open()) {
		cout << "file is open for writing..." << endl;
		f.write((char*)&size, sizeof(int));
		f.write((char*)workers, sizeof(Worker) * size);
		cout << "data is added..." << endl;
		f.close();
	}
	else {
		cout << "file is not for writing..." << endl;
	}
}

void showMenu() {
	cout << "\n========== МЕНЮ ==========" << endl;
	cout << "1. Добавить записи" << endl;
	cout << "2. Показать все записи" << endl;
	cout << "3. Удалить запись" << endl;
	cout << "4. Поиск записи по фамилии" << endl;
	cout << "5. Сортировка записей по количеству изделий" << endl;
	cout << "6. Сохранить в бинарный файл" << endl;
	cout << "0. Выход" << endl;
	cout << "Ваш выбор: ";
}

void menu(Worker*& workers, int& size) {
	int choice;
	const string filename = "workers.bin";

	do {
		showMenu();
		cin >> choice;

		switch (choice) {
		case 1: {
			int addSize;
			cout << "Введите количество записей: ";
			cin >> addSize;
			addRecords(workers, size, addSize);
			break;
		}
		case 2:
			vivodAll(workers, size);
			break;
		case 3: {
			if (size == 0) {
				cout << "Нет записей для удаления!" << endl;
				break;
			}
			int index;
			vivodAll(workers, size);
			cout << "Введите номер записи для удаления (1-" << size << "): ";
			cin >> index;
			deleteRecord(workers, size, index - 1);
			break;
		}
		case 4: {
			if (size == 0) {
				cout << "Нет записей для поиска!" << endl;
				break;
			}
			string searchFam;
			cout << "Введите фамилию для поиска: ";
			cin >> searchFam;
			searchByFam(workers, size, searchFam);
			break;
		}
		case 5: {
			if (size == 0) {
				cout << "Нет записей для сортировки!" << endl;
				break;
			}
			sortRecords(workers, size);
			cout << "\nРезультат сортировки:" << endl;
			vivodAll(workers, size);
			break;
		}
		case 6:
			if (size == 0) {
				cout << "Нет записей для сохранения!" << endl;
			}
			else {
				save("workes.bis", workers, size);
				break;
			}
			break;
		case 0:
			cout << "Программа завершена!" << endl;
			break;
		default:
			cout << "Неверный выбор!" << endl;
		}
	} while (choice != 0);
}

void delet(Worker*& workers, int& size) {
	if (workers != nullptr) {
		delete[] workers;
		workers = nullptr;
		size = 0;
	}
}

int main() {
	setlocale(LC_ALL, "Russian");
	srand(time(nullptr));

	Worker* workers = nullptr;
	int size = 0;

	menu(workers, size);
	delet(workers, size);

	return 0;
}
