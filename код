#include <iostream>
#include <fstream>
#include <string>
#include<locale>

using namespace std;

int main() {
    setlocale(LC_ALL, "RU");
	srand(time(0));
	string path = "D:\\99999\\";
	string int_filename = path + "input.txt";
	string out_filename = path + "output.txt";

	fstream f;
    f.open(int_filename, ios_base::out);
    for (int i = 0; i < 10; i++) {
        for (int j = 0; j < 20; j++) {
            int random = rand() % 100;
            if (random < 30) {
                int simfol = rand() % 3;
                if (simfol == 0) f << "*";
                else if (simfol == 1) f << "-";
                else f << "+";
                f << " ";
            }
        }
        f << "\n";
    }
    f.close();
cout << "file is created..." << endl;

f.open(int_filename, ios_base::in);
string content;
string line;
int starCount = 0;   
int minusCount = 0; 
int plusCount = 0;   

while (getline(f, line)) {
    content += line + "\n";

    for (int i = 0; i < line.length(); i++) {
        if (line[i] == '*') {
            starCount++;
        }
        else if (line[i] == '-') {
            minusCount++;
        }
        else if (line[i] == '+') {
            plusCount++;
        }
    }
}
f.close();

cout << "Содержимое исходного файла:" << endl;
cout << content << endl;

char popular = ' ';
int maxCount = 0;

if (starCount > maxCount) {
    maxCount = starCount;
    popular = '*';
}
if (minusCount > maxCount) {
    maxCount = minusCount;
    popular = '-';
}
if (plusCount > maxCount) {
    maxCount = plusCount;
    popular = '+';
}
string newContent = "";
for (int i = 0; i < content.length(); i++) {
    if (content[i] != popular) {
        newContent += content[i];
    }
}
content = newContent;

f.open(out_filename, ios_base::out);
f << content;
f << "\n\"*\" - " << starCount << "; \"-\" - " << minusCount << "; \"+\" - " << plusCount;
f.close();

cout << "Статистика символов:" << endl;
cout << "\"*\" - " << starCount << endl;
cout << "\"-\" - " << minusCount << endl;
cout << "\"+\" - " << plusCount << endl;

if (maxCount <= 0) {
    cout << "Ни один из символов (*, -, +) не найден в файле." << endl;
}

	return 0;
}
