    cout << s << n << endl;
}

struct Worker {
    string Fam;
    string Name;
    string Otch;
    string workshop;
    int quantity;
    char category;
};

string generateFam() {
    string Fam[] = { "Иванов", "Петров", "Сидоров", "Кузнецов", "Соколов", "Михайлов", "Федоров", "Морозов" };
    return Fam[rand() % 8];
}

string generateName() {
    string Name[] = { "Алексей", "Дмитрий", "Владимир", "Сергей", "Андрей", "Иван", "Максим", "Егор" };
    return Name[rand() % 8];
}

string generateOtch() {
    string Otch[] = { "Алексеевич", "Дмитриевич", "Владимирович", "Сергеевич", "Андреевич", "Иванович", "Максимович", "Егорович" };
    return Otch[rand() % 8];
}

string generateWorkshop() {
    string workshops[] = { "Цех №1", "Цех №2", "Цех №3", "Цех №4", "Цех №5" };
    return workshops[rand() % 5];
}

char generateCategory() {
    char categories[] = { 'A', 'B', 'C' };
    return categories[rand() % 3];
}

Worker setOneWorker(int _id) {
    Worker x;
    x.Fam = generateFam();
    x.Name = generateName();
    x.Otch = generateOtch();
    x.workshop = generateWorkshop();
    x.quantity = rand() % 100 + 1;
    x.category = generateCategory();
    return x;
}

void setWorkers(Worker* x, int count) {
    for (int i = 0; i < count; i++) {
        x[i] = setOneWorker(i);
    }
}

void printOneWorker(Worker& x) {
    cout << x.Fam << " " << x.Name << " " << x.Otch << " " << x.workshop << " " << x.quantity << " " << x.category << endl;
}

void printWorkers(Worker* x, int count) {
    for (int i = 0; i < count; i++) {
        printOneWorker(x[i]);
    }
}

Worker* newMassiv(int N) {
    Worker* x = new Worker[N];
    return x;
}

void deleteMassiv(Worker*& x) {
    delete[] x;
    x = nullptr;
}

void addRecords(Worker*& x, int& N, int add) {
    Worker* newX = newMassiv(N + add);
    for (int i = 0; i < N; i++)
        newX[i] = x[i];
    for (int i = 0; i < add; i++)
        newX[N + i] = setOneWorker(N + i);
    deleteMassiv(x);
    x = newX;
    N += add;
}

void deleteRecords(Worker*& x, int& N) {
    deleteMassiv(x);
    N = 0;
    cout << "записи удалены" << endl;
}

void drk(int& a) {
    do {
        input(a, "введите выбор: ");
        if (a < 1)
            cout << "повторите ваш выбор" << endl;
        if (a > 7)
            cout << "повторите ваш выбор" << endl;
    } while (a < 1 || a > 7);
    cout << "продолжаем..." << endl;
}

template <typename example>
void funcFindData(Worker* x, int N, example Worker::* a, string s) {
    example b;
    input(b, s);
    for (int i = 0; i < N; i++) {
        if (x[i].*a == b)
            printOneWorker(x[i]);
    }
}

