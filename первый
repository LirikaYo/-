using namespace std;

template <typename example>
void input(example& n, string s) {
    cout << s;
    cin >> n;
}

template <typename example>
void output(example n, string s) {
    cout << s << n << endl;
}

struct Worker {
    string Fam;
    string Name;
    string Otch;
    string workshop;
    int quantity;
    char category;
};

string generateFam() {
    string Fam[] = {
        "Ivanov", "Petrov", "Sidorov", "Kuznetsov", "Sokolov", "Mikhailov", "Fedorov", "Morozov" };
    return Fam[rand() % 8];
}

string generateName() {
    string Name[] = {
        "Alexey", "Dmitry", "Vladimir", "Sergey", "Andrey", "Ivan", "Maxim", "Egor" };
    return Name[rand() % 8];
}

string generateOtch() {
    string Otch[] = {
        "Alexeyevich", "Dmitrievich", "Vladimirovich", "Sergeevich", "Andreevich", "Ivanovich", "Maximovich", "Egorovich" };
    return Otch[rand() % 8];
}

string generateWorkshop() {
    string workshops[] = {
        "Цех №1", "Цех №2", "Цех №3", "Цех №4", "Цех №5" };
    return workshops[rand() % 5];
}

char generateCategory() {
    char categories[] = { 'A', 'B', 'C' };
    return categories[rand() % 3];
}

Worker setOneWorker(int _id) {
    Worker x;
    x.Fam = generateFam();
    x.Name = generateName();
    x.Otch = generateOtch();
    x.workshop = generateWorkshop();
    x.quantity = rand() % 100 + 1;
    x.category = generateCategory();
    return x;
}

void setWorkers(Worker* x, int count) {
    for (int i = 0; i < count; i++) {
        x[i] = setOneWorker(i);
    }
}

void printOneWorker(Worker& x) {
    cout << x.Fam << " " << x.Name << " " << x.Otch << " " << x.workshop << " " << x.quantity << " " << x.category << endl;
}

void printWorkers(Worker* x, int count) {
    if (count == 0) {
        cout << "Записей нет" << endl;
        return;
    }
    for (int i = 0; i < count; i++) {
        printOneWorker(x[i]);
    }
}

Worker* newMassiv(int N) {
    Worker* x = new Worker[N];
    return x;
}

void deleteMassiv(Worker*& x) {
    delete[] x;
    x = nullptr;
}

void addRecords(Worker*& x, int& N, int add) {
    Worker* newX = newMassiv(N + add);
    for (int i = 0; i < N; i++)
        newX[i] = x[i];
    for (int i = 0; i < add; i++)
        newX[N + i] = setOneWorker(N + i);
    deleteMassiv(x);
    x = newX;
    N += add;
}

void deleteRecords(Worker*& x, int& N) {
    if (N == 0) {
        cout << "Записей нет" << endl;
        return;
    }
    deleteMassiv(x);
    N = 0;
    cout << "записи удалены" << endl;
}

void tmpRecords(Worker& a, Worker& b) {
    Worker tmp = a;
    a = b;
    b = tmp;
}

void sortByFam(Worker* x, int N) {
    if (N == 0) {
        cout << "Фамилий нет" << endl;
        return;
    }
    bool flag;
    for (int i = 0; i < N; i++) {
        flag = true;
        for (int j = 0; j < N - 1; j++) {
            if (x[j].Fam > x[j + 1].Fam) {
                flag = false;
                tmpRecords(x[j], x[j + 1]);
            }
        }
        if (flag)
            break;
    }
    cout << "\n=== Отсортированные по фамилиям записи ===" << endl;
}

void findData(Worker* x, int N) {
    if (N == 0) {
        cout << "Фамилий нет..." << endl;
        return;
    }
    string fam;
    input(fam, "введите Фамилию для поиска = ");
    bool famil = false;
    for (int i = 0; i < N; i++) {
        if (x[i].Fam == fam) {
            printOneWorker(x[i]);
            famil = true;
        }
    }
    if (!famil) {
        cout << "фамилия " << fam << " не найдена" << endl;
    }
}


void createFile(Worker* x, int N, string& file) {
    fstream f;
    f.open(file, ios_base::out | ios_base::binary);
    if (f.is_open()) {
        for (int i = 0; i < N; i++) {
            f.write((char*)&x[i], sizeof(Worker));
        }
        f.close();
    }
    else {
        cout << "файл не открыт для записи..." << endl;
    }
}

void readFile(Worker* x, int N, string& file) {
    fstream f;
    f.open(file, ios_base::in | ios_base::binary);
    if (f.is_open()) {
        cout << "файл открыт для чтения..." << endl;
        f.seekg(0, ios::end);
        int size = f.tellg() / sizeof(Worker);
        f.seekg(0, ios::beg);
        x = newMassiv(size);
        for (int i = 0; i < size; i++) {
            f.read((char*)&x[i], sizeof(Worker));
        }
        N = size;
        f.close();
    }
    else {
        cout << "файл не открыт для чтения..." << endl;
    }
}

void recreateFile(Worker* x, int N, string& file) {
    fstream f;
    f.open(file, ios_base::out | ios_base::binary);
    if (f.is_open()) {
        for (int i = 0; i < N; i++) {
            f.write((char*)&x[i], sizeof(Worker));
        }
        f.close();
    }
    else {
        cout << "файл не открыт для записи..." << endl;
    }
}

void print(string& file) {
    int num;
    int N = 0;
    Worker* x = nullptr;

    readFile(x, N, file);

    do {
        cout << "\n========== МЕНЮ ==========" << endl;
        cout << "1. Добавить записи" << endl;
        cout << "2. Показать все записи" << endl;
        cout << "3. Удалить все записи" << endl;
        cout << "4. Сортировка по фамилиям" << endl;
        cout << "5. Поиск по фамилии" << endl;
        cout << "0. Выход" << endl;
        cout << "Ваш выбор: ";

        input(num, "");

        switch (num) {
        case(1):
            if (N == 0) {
                input(N, "введите n = ");
                output(N, "N = ");
                x = newMassiv(N);
                setWorkers(x, N);
                createFile(x, N, file);
            }
            else {
                int add;
                input(add, "введите add = ");
                addRecords(x, N, add);
                output(N, "N = ");
                recreateFile(x, N, file);
            }
            break;
        case(2):
            printWorkers(x, N);
            createFile(x, N, file);
            break;
        case(3):
            deleteRecords(x, N);
            recreateFile(x, N, file);
            break;
        case(4):
            sortByFam(x, N);
            recreateFile(x, N, file);
            printWorkers(x, N);
            break;
        case(5):
            findData(x, N);
            break;
        case(0):
            cout << "Выход" << endl;
            printWorkers(x, N);
            deleteMassiv(x);
            break;
        default:
            cout << "Неверный выбор" << endl;
        }
    } while (num != 0);
}

