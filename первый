    }
}

void tmpRecords(Worker& a, Worker& b) {
    Worker tmp = a;
    a = b;
    b = tmp;
}

template <typename example>
void funcSortRecords(Worker* x, int N, example Worker::* a) {
    bool flag;
    for (int i = 0; i < N; i++) {
        flag = true;
        for (int j = 0; j < N - 1; j++) {
            if (x[j].*a > x[j + 1].*a) {
                flag = false;
                tmpRecords(x[j], x[j + 1]);
            }
        }
        if (flag)
            break;
    }
}

void sortRecords(Worker* x, int N) {
    int choice;
    cout << "1. Фамилия" << " " << "2. Имя" << " " << "3. Отчество" << " " << "4. Цех" << " " << "5. Категория" << " " << "6. Количество" << endl;
    drk(choice);
    switch (choice) {
    case(1):
        funcSortRecords(x, N, &Worker::Fam);
        break;
    case(2):
        funcSortRecords(x, N, &Worker::Name);
        break;
    case(3):
        funcSortRecords(x, N, &Worker::Otch);
        break;
    case(4):
        funcSortRecords(x, N, &Worker::workshop);
        break;
    case(5):
        funcSortRecords(x, N, &Worker::category);
        break;
    case(6):
        funcSortRecords(x, N, &Worker::quantity);
        break;
    default:
        cout << "Неверный выбор" << endl;
    }
    printWorkers(x, N);
}

void createFile(Worker* x, int N, string& file) {
    fstream f;
    f.open(file, ios_base::out | ios_base::binary);
    if (f.is_open()) {
        cout << "файл открыт для записи..." << endl;
        for (int i = 0; i < N; i++) {
            f.write((char*)&x[i], sizeof(Worker));
        }
        cout << "данные добавлены..." << endl;
        f.close();
    }
    else {
        cout << "файл не открыт для записи..." << endl;
    }
}

void readFile(Worker* x, int N, string& file) {
    fstream f;
    f.open(file, ios_base::in | ios_base::binary);
    if (f.is_open()) {
        cout << "файл открыт для чтения..." << endl;
        f.seekg(0, ios::end);
        int size = f.tellg() / sizeof(Worker);
        f.seekg(0, ios::beg);
        x = newMassiv(size);
        for (int i = 0; i < size; i++) {
            f.read((char*)&x[i], sizeof(Worker));
        }
        N = size;
        f.close();
    }
    else {
        cout << "файл не открыт для чтения..." << endl;
    }
}

void recreateFile(Worker* x, int N, string& file) {
    fstream f;
    f.open(file, ios_base::out | ios_base::binary);
    if (f.is_open()) {
        for (int i = 0; i < N; i++) {
            f.write((char*)&x[i], sizeof(Worker));
        }
        cout << "файл пересоздан..." << endl;
        f.close();
    }
    else {
        cout << "файл не открыт для записи..." << endl;
    }
}

void print(string& file) {
    int num;
    int N = 0;
    Worker* x = nullptr;

    readFile(x, N, file);

    do {
        input(num, "введите номер: ");
        switch (num) {
        case(1):
            if (N == 0) {
                input(N, "введите n = ");
                output(N, "N = ");
                x = newMassiv(N);
                setWorkers(x, N);
            }
            else {
                int add;
                input(add, "введите add = ");
                addRecords(x, N, add);
                output(N, "N = ");
                recreateFile(x, N, file);
            }
            break;
        case(2):
            printWorkers(x, N);
            createFile(x, N, file);
            break;
        case(3):
            deleteRecords(x, N);
            recreateFile(x, N, file);
            break;
        case(4):
            sortRecords(x, N);
            recreateFile(x, N, file);
            break;
        case(5):
            findData(x, N);
            break;
        case(0):
            cout << "Выход" << endl;
            printWorkers(x, N);
            deleteMassiv(x);
            break;
        default:
            cout << "Неверный выбор" << endl;
        }
    } while (num != 6);
}

