void sluch_simfol(string filename, int stroki) {
	fstream f;
	f.open(filename, ios_base::out);

	cin.ignore();

	string stroka;

	for (int i = 1; i <= stroki; i++) {
		cout << "Строка №" << i << " Введите символы: ";
		getline(cin, stroka);

		bool prafilnost = true;
		for (int j = 0; j < stroka.length(); j++) {
			if (stroka[j] != '-' && stroka[j] != '+' && stroka[j] != '*' && stroka[j] != ' ') {
				prafilnost = false;
				break;
			}
		}
		if (!prafilnost) {
			cout << "Можно только *, -, + " << endl;
			i--;
		}
		else {
			f << stroka << "\n";
		}
	}
	f.close();
	cout << "file is created..." << endl;
}
void podchet(string filename, string& content, int& starCount, int& minusCount, int& plusCount) {
	fstream f;
	f.open(filename, ios_base::in);
	string line;

	while (getline(f, line)) {
		content += line + "\n";

		for (int i = 0; i < line.length(); i++) {
			if (line[i] == '*') {
				starCount++;
			}
			else if (line[i] == '-') {
				minusCount++;
			}
			else if (line[i] == '+') {
				plusCount++;
			}
		}
	}
	f.close();
}

char popularSimfol(int starCount, int minusCount, int plusCount, int& maxCount) {
	char popular = ' ';
	maxCount = 0;

	if (starCount > maxCount) {
		maxCount = starCount;
		popular = '*';
	}
	if (minusCount > maxCount) {
		maxCount = minusCount;
		popular = '-';
	}
	if (plusCount > maxCount) {
		maxCount = plusCount;
		popular = '+';
	}
	return popular;
}
string deleteSimvol(string text, char symbol) {
	string newContent = "";
	for (int i = 0; i < text.length(); i++) {
		if (text[i] != symbol) {
			newContent += text[i];
		}
	}
	return newContent;
}
void result(string filename, string content, int starCount, int minusCount, int plusCount) {
	fstream f;
	f.open(filename, ios_base::out);
	f << content;
	f << "\n\"*\" - " << starCount << "; \"-\" - " << minusCount << "; \"+\" - " << plusCount;
	f.close();
}
void vivod(int starCount, int minusCount, int plusCount, int maxCount) {
	cout << "Статистика символов:" << endl;
	cout << "\"*\" - " << starCount << endl;
	cout << "\"-\" - " << minusCount << endl;
	cout << "\"+\" - " << plusCount << endl;

	if (maxCount <= 0) {
		cout << "Ни один из символов (*, -, +) не найден в файле." << endl;
	}
}
