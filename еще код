#define _CRT_SECURE_NO_WARNINGS

#include <iostream>
#include <fstream>
#include <string>
#include <ctime>
#include <cstring>

using namespace std;

struct Worker {
    char Fam[50];
    char Name[50];
    char Otch[50];
    char workshop[50];
    int quantity;
    char category;
};

string generateFam() {
    string Fam[] = { "Ivanov", "Petrov", "Sidorov", "Kuznetsov", "Sokolov", "Mikhailov", "Fedorov", "Morozov" };
    return Fam[rand() % 8];
}

string generateName() {
    string Name[] = { "Alexey", "Dmitry", "Vladimir", "Sergey", "Andrey", "Ivan", "Maxim", "Egor" };
    return Name[rand() % 8];
}

string generateOtch() {
    string Otch[] = { "Alexeyevich", "Dmitrievich", "Vladimirovich", "Sergeevich", "Andreevich", "Ivanovich", "Maximovich", "Egorovich" };
    return Otch[rand() % 8];
}

string generateWorkshop() {
    string workshops[] = { "Цех №1", "Цех №2", "Цех №3", "Цех №4", "Цех №5" };
    return workshops[rand() % 5];
}

char generateCategory() {
    char categories[] = { 'A', 'B', 'C' };
    return categories[rand() % 3];
}

void generateRecord(Worker& x) {
    string fam = generateFam();
    string name = generateName();
    string otch = generateOtch();
    string workshop = generateWorkshop();

    for (size_t i = 0; i < fam.length() && i < 49; i++) {
        x.Fam[i] = fam[i];
    }
    x.Fam[fam.length()] = '\0';

    for (size_t i = 0; i < name.length() && i < 49; i++) {
        x.Name[i] = name[i];
    }
    x.Name[name.length()] = '\0';

    for (size_t i = 0; i < otch.length() && i < 49; i++) {
        x.Otch[i] = otch[i];
    }
    x.Otch[otch.length()] = '\0';

    for (size_t i = 0; i < workshop.length() && i < 49; i++) {
        x.workshop[i] = workshop[i];
    }
    x.workshop[workshop.length()] = '\0';

    x.quantity = rand() % 100 + 1;
    x.category = generateCategory();
}

void oneWorker(const Worker& w, int index) {
    cout << index + 1 << ". "
        << w.Fam << " " << w.Name << " " << w.Otch
        << ", Цех: " << w.workshop
        << ", Количество: " << w.quantity
        << ", Категория: " << w.category << endl;
}

void vivodAll(Worker* workers, int size) {
    if (size == 0) {
        cout << "Нет записей!" << endl;
        return;
    }
    cout << "\n========== ВСЕ ЗАПИСИ ==========" << endl;
    for (int i = 0; i < size; i++) {
        oneWorker(workers[i], i);
    }
    cout << "=================================" << endl;
}

// ========== 1) ФУНКЦИЯ ДЛЯ УДАЛЕНИЯ ЗАПИСЕЙ ==========
void deleteRecord(Worker*& workers, int& size, int index) {
    if (index < 0 || index >= size) {
        cout << "Неверный индекс!" << endl;
        return;
    }

    Worker* new_workers = new Worker[size - 1];

    // Копируем элементы ДО удаляемого
    for (int i = 0; i < index; i++) {
        new_workers[i] = workers[i];
    }

    // Копируем элементы ПОСЛЕ удаляемого (со сдвигом влево на 1)
    for (int i = index + 1; i < size; i++) {
        new_workers[i - 1] = workers[i];
    }

    delete[] workers;
    workers = new_workers;
    size--;

    cout << "Запись успешно удалена!" << endl;
}

// ========== 2) ФУНКЦИЯ ПОИСКА ДАННЫХ (по фамилии) ==========
void searchByFam(Worker* workers, int size, const string& searchFam) {
    bool found = false;
    cout << "\n========== РЕЗУЛЬТАТЫ ПОИСКА ==========" << endl;
    for (int i = 0; i < size; i++) {
        if (workers[i].Fam == searchFam) {
            oneWorker(workers[i], i);
            found = true;
        }
    }
    if (!found) {
        cout << "Рабочий с фамилией \"" << searchFam << "\" не найден!" << endl;
    }
    cout << "=========================================" << endl;
}

// ========== 3) ФУНКЦИЯ СОРТИРОВКИ ЗАПИСЕЙ ПО ОДНОМУ ИЗ ПОЛЕЙ ==========
void sortRecords(Worker* workers, int size, int fieldChoice) {
    if (size <= 1) return;

    for (int i = 0; i < size - 1; i++) {
        for (int j = 0; j < size - i - 1; j++) {
            bool needSwap = false;

            switch (fieldChoice) {
            case 1:  // по фамилии
                if (strcmp(workers[j].Fam, workers[j + 1].Fam) > 0) needSwap = true;
                break;
            case 2:  // по количеству изделий
                if (workers[j].quantity > workers[j + 1].quantity) needSwap = true;
                break;
            case 3:  // по категории
                if (workers[j].category > workers[j + 1].category) needSwap = true;
                break;
            default:
                cout << "Неверный выбор поля!" << endl;
                return;
            }

            if (needSwap) {
                swap(workers[j], workers[j + 1]);
            }
        }
    }
    cout << "Сортировка выполнена!" << endl;
}

// ========== ДОБАВЛЕНИЕ ЗАПИСЕЙ (автоматическое) ==========
void addRecords(Worker*& workers, int& size, int addSize) {
    if (addSize <= 0) {
        cout << "Количество записей должно быть больше 0!" << endl;
        return;
    }

    Worker* new_workers = new Worker[size + addSize];

    for (int i = 0; i < size; i++) {
        new_workers[i] = workers[i];
    }

    for (int i = 0; i < addSize; i++) {
        generateRecord(new_workers[size + i]);
    }

    delete[] workers;
    workers = new_workers;
    size += addSize;
    cout << "Добавлено " << addSize << " записей автоматически! Всего: " << size << endl;
}

// ========== РАБОТА С БИНАРНЫМИ ФАЙЛАМИ (без reinterpret_cast) ==========
void save(const string& filename, Worker* workers, int size) {
    FILE* f = fopen(filename.c_str(), "wb");

    if (f == NULL) {
        cout << "Не удалось открыть." << endl;
        return;
    }

    fwrite(&size, sizeof(int), 1, f);
    fwrite(workers, sizeof(Worker), size, f);
    fclose(f);

    cout << "Сохранено: " << filename << " (" << size << " записей)" << endl;
}

void load(const string& filename, Worker*& workers, int& size) {
    FILE* f = fopen(filename.c_str(), "rb");

    if (f == NULL) {
        cout << "Не удалось открыть!" << endl;
        return;
    }

    int newSize;
    fread(&newSize, sizeof(int), 1, f);

    if (newSize <= 0) {
        cout << "Файл не содержит записей!" << endl;
        fclose(f);
        return;
    }

    Worker* new_workers = new Worker[newSize];
    fread(new_workers, sizeof(Worker), newSize, f);
    fclose(f);

    if (workers != nullptr) {
        delete[] workers;
    }

    workers = new_workers;
    size = newSize;
    cout << "Загружено из бинарного файла: " << filename << " (" << size << " записей)" << endl;
}

void showMenu() {
    cout << "\n========== МЕНЮ ==========" << endl;
    cout << "1. Добавить записи" << endl;
    cout << "2. Показать все записи" << endl;
    cout << "3. Удалить запись" << endl;
    cout << "4. Поиск записи (по фамилии)" << endl;
    cout << "5. Сортировка записей" << endl;
    cout << "6. Сохранить в бинарный файл" << endl;
    cout << "7. Загрузить из бинарного файла" << endl;
    cout << "0. Выход" << endl;
    cout << "Ваш выбор: ";
}

void menu(Worker*& workers, int& size) {
    int choice;
    const string filename = "D:\\workers.dat";

    do {
        showMenu();
        cin >> choice;

        switch (choice) {
        case 1: {
            int addSize;
            cout << "Введите количество записей для добавления: ";
            cin >> addSize;
            addRecords(workers, size, addSize);
            break;
        }
        case 2:
            vivodAll(workers, size);
            break;
        case 3: {
            if (size == 0) {
                cout << "Нет записей для удаления!" << endl;
                break;
            }
            int index;
            vivodAll(workers, size);
            cout << "Введите номер записи для удаления (1-" << size << "): ";
            cin >> index;
            deleteRecord(workers, size, index - 1);
            break;
        }
        case 4: {
            if (size == 0) {
                cout << "Нет записей для поиска!" << endl;
                break;
            }
            string searchFam;
            cout << "Введите фамилию для поиска: ";
            cin >> searchFam;
            searchByFam(workers, size, searchFam);
            break;
        }
        case 5: {
            if (size == 0) {
                cout << "Нет записей для сортировки!" << endl;
                break;
            }
            int fieldChoice;
            cout << "Выберите поле для сортировки:\n";
            cout << "1. По фамилии\n";
            cout << "2. По количеству изделий\n";
            cout << "3. По категории\n";
            cout << "Ваш выбор: ";
            cin >> fieldChoice;
            sortRecords(workers, size, fieldChoice);
            cout << "\nРезультат сортировки:" << endl;
            vivodAll(workers, size);
            break;
        }
        case 6:
            if (size == 0) {
                cout << "Нет записей для сохранения!" << endl;
            }
            else {
                save(filename, workers, size);
            }
            break;
        case 7:
            load(filename, workers, size);
            break;
        case 0:
            cout << "Программа завершена!" << endl;
            break;
        default:
            cout << "Неверный выбор!" << endl;
        }
    } while (choice != 0);
}
void delet(Worker*& workers, int& size) {
    if (workers != nullptr) {
        delete[] workers;
        workers = nullptr; 
        size = 0; 
    }
}

int main() {
    setlocale(LC_ALL, "Russian");
    srand(time(nullptr));

    Worker* workers = nullptr;
    int size = 0;

    menu(workers, size);
    delet(workers, size);

    return 0;
}
