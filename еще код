// Объявление функции для заполнения массива людьми
void setPeople(people* x, int count) {
	for (int i = 0; i < count; i++) {
		x[i] = setOnePeople(i);
	}
}
// Объявление функции для вывода одного человека
void printOnePeople(people& x) {
	cout << x.id << " " << x.Fam << " " << x.Name << " " << x.Otch << " " << x.Mail << " " << x.WebPage << " " << x.ICQnumber << endl;
}
// Объявление функции для вывода всех людей
void printPeople(people* x, int count) {
	for (int i = 0; i < count; i++) {
		printOnePeople(x[i]);
	}
}
// Объявление функции для выделения памяти для массива
people* newMassiv(int N) {
	people* x = new people[N];
	return x;
}
// Объявление функции для возврата памяти
void deleteMassiv(people*& x) {
	delete[]x;
	x = nullptr;
}

// Объявление функции для добавления записей
void addRecords(people*& x, int& N, int add) {
	people* newX = newMassiv(N + add);
	for (int i = 0; i < N; i++)
		newX[i] = x[i];
	for (int i = 0; i < add; i++)
		newX[N + i] = setOnePeople(N + i);
	deleteMassiv(x);
	x = newX;
	N += add;
}

// Функция для удаления записей
void deleteRecords(people*& x, int& N) {
	deleteMassiv(x);
	N = 0;
	cout << "records deleted" << endl;
}
