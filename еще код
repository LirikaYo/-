}
// Функция сортировки
void sortRecords(people* x, int N) {
	int choice;
	cout << "1. ID" << " " << "2. Familiya" << " " << "3. Name" << " " << "4. Otchestvo" << " " << "5. Mail" << " " << "6. WebPage" << " " << "7. ICQ" << endl;
	drk(choice);
	int count = 0;  
	bool flag;
	for (int i = 0; i < N; i++) {
		flag = true;                   
		for (int j = 0; j < N - 1; j++) {
			count++;
			// Сортировка по ID
			if (choice == 1) {
				if (x[j].id > x[j + 1].id) {
					flag = false;
					tmpRecords(x[j], x[j + 1]);
				}
			}
			// Сортировка по фамилии
			if (choice == 2) {
				if (x[j].Fam > x[j + 1].Fam) {
					flag = false;
					tmpRecords(x[j], x[j + 1]);
				}
			}
			// Сортировка по имени
			if (choice == 3) {
				if (x[j].Name > x[j + 1].Name) {
					flag = false;
					tmpRecords(x[j], x[j + 1]);
				}
			}
			// Сортировка по отчеству
			if (choice == 4) {
				if (x[j].Otch > x[j + 1].Otch) {
					flag = false;
					tmpRecords(x[j], x[j + 1]);
				}
			}
			// Сортировка по почте
			if (choice == 5) {
				if (x[j].Mail > x[j + 1].Mail) {
					flag = false;
					tmpRecords(x[j], x[j + 1]);
				}
			}
			// Сортировка по веб странице
			if (choice == 6) {
				if (x[j].WebPage > x[j + 1].WebPage) {
					flag = false;
					tmpRecords(x[j], x[j + 1]);
				}
			}
			// Сортировка по ICQ номеру
			if (choice == 7) {
				if (choice == 7 && x[j].ICQnumber > x[j + 1].ICQnumber) {
					flag = false;
					tmpRecords(x[j], x[j + 1]);
				}
			}
		}
		cout << endl;
		if (flag) 
			break;
	}
	// Вывод результата
	for (int i = 0; i < N; i++) {
		printOnePeople(x[i]);
	}
}
// Объявление функции для меню
void print() {
	int num;
	int N = 0;
	people* x = nullptr;
	do {
		input(num, "input case: ");
		switch (num) {
		// Кейс ввода записей
		case(1):
			// Условие, если ввода не было
			if (N == 0) {
				input(N, "input n = ");
				output(N, "N = ");
				x = newMassiv(N);
				setPeople(x, N);
				break;
			}
			//Условие, если ввод записей уже произошёл
			else {
				int add;
				input(add, "input add = ");
				addRecords(x, N, add);
				output(N, "N = ");
				break;
			}
		// Кейс вывода случайных записей
		case(2):
			printPeople(x, N);
			break;
		// Кейс удаления записей
		case(3):
			deleteRecords(x, N);
			break;
		// Кейс освобождения и выхода из функции
		case(4):
			sortRecords(x, N);
			break;
		// Кейс поиска данных
		case(5):
			findData(x, N);
			break;
		// Кейс выхода
		case(6):
			cout << "Exit" << endl;
			deleteMassiv(x);
			_getch();
			break;
		default:
			cout << "Wrong choice" << endl;
		}
	} while (num != 6);
}
