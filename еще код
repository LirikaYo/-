#include <iostream>
#include <fstream>
#include <string>
#include <ctime>
#include <locale>

using namespace std;

struct Worker {
    string Fam;
    string Name;
    string Otch; 
    string workshop;   
    int quantity;      
    char category;    
};

template<typename T>
void input(T& x, string msg) {
    cout << msg;
    cin >> x;
}

string generateFam() {
    string Fam[] = { "Ivanov", "Petrov", "Sidorov", "Kuznetsov", "Sokolov", "Mikhailov", "Fedorov", "Morozov" };
    return Fam[rand() % 8];
}

string generateName() {
    string Name[] = { "Alexey", "Dmitry", "Vladimir", "Sergey", "Andrey", "Ivan", "Maxim", "Egor" };
    return Name[rand() % 8];
}

string generateOtch() {
    string Otch[] = { "Alexeyevich", "Dmitrievich", "Vladimirovich", "Sergeevich", "Andreevich", "Ivanovich", "Maximovich", "Egorovich" };
    return Otch[rand() % 8];
}

string generateWorkshop() {
    string workshops[] = { "Workshop No.1", "Workshop No.2", "Workshop No.3", "Assembly shop", "Machine shop" };
    return workshops[rand() % 5];
}

char generateCategory() {
    char categories[] = { 'A', 'B', 'C' };
    return categories[rand() % 3];
}

void generateRecord(Worker& x) {
    x.Fam = generateFam();
    x.Name = generateName();
    x.Otch = generateOtch();
    x.workshop = generateWorkshop();
    x.quantity = rand() % 100 + 1; 
    x.category = generateCategory();
}

void printRecord(Worker w, int index) {
    cout << index + 1 << ". "
        << w.Name << " " << w.Fam << " " << w.Otch
        << ", Цех: " << w.workshop
        << ", Количество: " << w.quantity
        << ", Категория: " << w.category << endl;
}

void vivodAllWorkers(Worker* workers, int size) {
    if (size == 0) {
        cout << "Нет записей о рабочих!" << endl;
        return;
    }
    cout << "\n=== СПИСОК РАБОЧИХ ===\n";
    for (int i = 0; i < size; i++) {
        printRecord(workers[i], i);
    }
    cout << "========================\n\n";
}

void deleteRecord(Worker*& workers, int& size, int index) {
    if (index < 0 || index >= size) {
        cout << "Ошибка: неверный индекс для удаления!" << endl;
        return;
    }

    Worker* newWorkers = new Worker[size - 1];
    for (int i = 0, j = 0; i < size; i++) {
        if (i != index) {
            newWorkers[j++] = workers[i];
        }
    }

    delete[] workers;
    workers = newWorkers;
    size--;
    cout << "Запись успешно удалена!" << endl;
}

void searchByFam(Worker* workers, int size, string searchFam) {
    bool found = false;
    cout << "\n=== РЕЗУЛЬТАТЫ ПОИСКА (фамилия: " << searchFam << ") ===\n";
    for (int i = 0; i < size; i++) {
        if (workers[i].Fam == searchFam) {
            printRecord(workers[i], i);
            found = true;
        }
    }
    if (!found) {
        cout << "Рабочие с фамилией \"" << searchFam << "\" не найдены." << endl;
    }
    cout << "============================================\n\n";
}

void sortWorkers(Worker* workers, int size, int fieldChoice) {
    if (size <= 1) return;

    for (int i = 0; i < size - 1; i++) {
        for (int j = 0; j < size - i - 1; j++) {
            bool needSwap = false;

            switch (fieldChoice) {
            case 1: 
                if (workers[j].Fam > workers[j + 1].Fam) needSwap = true;
                break;
            case 2: 
                if (workers[j].quantity > workers[j + 1].quantity) needSwap = true;
                break;
            case 3: 
                if (workers[j].category > workers[j + 1].category) needSwap = true;
                break;
            case 4: 
                if (workers[j].workshop > workers[j + 1].workshop) needSwap = true;
                break;
            default:
                cout << "Неверный выбор поля для сортировки!" << endl;
                return;
            }

            if (needSwap) {
                swap(workers[j], workers[j + 1]);
            }
        }
    }
    cout << "Сортировка выполнена!" << endl;
}

void deleteArray(Worker*& workers) {
    delete[] workers;
    workers = nullptr;
}

void Menu() {
    Worker* workers = nullptr;
    int currentSize = 0;
    int choice;

    do {
        cout << "\n=== УЧЕТ ИЗДЕЛИЙ РАБОЧИХ ===\n";
        cout << "1. Добавить записи о рабочих\n";
        cout << "2. Показать всех рабочих\n";
        cout << "3. Удалить запись (по индексу)\n";
        cout << "4. Поиск по фамилии\n";
        cout << "5. Сортировка записей\n";
        cout << "0. Выход\n";
        cout << "Ваш выбор: ";
        input(choice, "");

        switch (choice) {
        case 1: {
            int addSize;
            input(addSize, "Введите количество записей для добавления: ");

            if (addSize <= 0) {
                cout << "Количество записей должно быть больше 0!" << endl;
                break;
            }

            Worker* newWorkers = new Worker[currentSize + addSize];

            for (int i = 0; i < currentSize; i++) {
                newWorkers[i] = workers[i];
            }

            for (int i = 0; i < addSize; i++) {
                generateRecord(newWorkers[currentSize + i]);
            }

            delete[] workers;
            workers = newWorkers;
            currentSize += addSize;
            cout << "Добавлено " << addSize << " записей! Всего: " << currentSize << endl;
            break;
        }
        case 2: {
            vivodAllWorkers(workers, currentSize);
            break;
        }
        case 3: {
            if (currentSize == 0) {
                cout << "Нет записей для удаления!" << endl;
                break;
            }
            int index;
            vivodAllWorkers(workers, currentSize);
            input(index, "Введите номер записи для удаления (1-" + to_string(currentSize) + "): ");
            deleteRecord(workers, currentSize, index - 1);
            break;
        }
        case 4: {
            if (currentSize == 0) {
                cout << "Нет записей для поиска!" << endl;
                break;
            }
            string searchName;
            input(searchName, "Введите фамилию для поиска: ");
            searchByFam(workers, currentSize, searchName);
            break;
        }
        case 5: {
            if (currentSize == 0) {
                cout << "Нет записей для сортировки!" << endl;
                break;
            }
            int fieldChoice;
            cout << "Выберите поле для сортировки:\n";
            cout << "1. По фамилии\n";
            cout << "2. По количеству изделий\n";
            cout << "3. По категории\n";
            cout << "4. По цеху\n";
            cout << "Ваш выбор: ";
            input(fieldChoice, "");
            sortWorkers(workers, currentSize, fieldChoice);
            cout << "Отсортированный список:\n";
            vivodAllWorkers(workers, currentSize);
            break;
        }
        case 0: {
            cout << "Выход из программы..." << endl;
            break;
        }
        default: {
            cout << "Неверный выбор! Попробуйте снова." << endl;
            break;
        }
        }
    } while (choice != 0);

    if (workers != nullptr) {
        deleteArray(workers);
    }
}

int main() {
    setlocale(LC_ALL, "Russian");
    srand(time(0));

    Menu();

    return 0;
}
