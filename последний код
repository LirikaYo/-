// Универсальная сортировка
template <typename example>
void funcSortRecords(people* x, int N, example people::* a) {
    bool flag;
    for (int i = 0; i < N; i++) {
        flag = true;
        for (int j = 0; j < N - 1; j++) {
            if (x[j].*a > x[j + 1].*a) {
                flag = false;
                tmpRecords(x[j], x[j + 1]);
            }
        }
        if (flag)
            break;
    }
}
