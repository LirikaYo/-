// Функция создания файла
void createFile(people* x, int N, string& file) {
    fstream f;
    f.open(file, ios_base::out | ios_base::binary);
    if (f.is_open()) {
        cout << "file is open for writing..." << endl;
        for (int i = 0; i < N; i++) {
            f.write((char*)&x[i], sizeof(people));
        }
        cout << "data is added..." << endl;
        f.close();
    }
    else {
        cout << "file is not open for writing..." << endl;
    }
}
//Функция чтения файла
void readFile(people* x, int N, string& file) {
    fstream f;
    f.open(file, ios_base::in | ios_base::binary);
    if (f.is_open()) {
        cout << "file is open for reading..." << endl;
        f.seekg(0 * ios::end);
        int size = f.tellg() / sizeof(people);
        f.seekg(0 * ios::beg);
        x = newMassiv(size);
        for (int i = 0; i < size; i++) {
            f.read((char*)&x[i], sizeof(people));
        }
        N = size;
        f.close();
    }
    else {
        cout << "file is not open for reading..." << endl;
    }
}
void recreateFile(people* x, int N, string& file) {
    fstream f;
    f.open(file, ios_base::out | ios_base::binary);
    if (f.is_open()) {
        for (int i = 0; i < N; i++) {
            f.write((char*)&x[i], sizeof(people));
        }
        cout << "file is recreated..." << endl;
        f.close();
    }
    else {
        cout << "file is not open for writing..." << endl;
    }
}
// Основное меню работы с записями
void print(string& file) {
    int num;
    int N = 0;
    people* x = nullptr;
    // При старте пытаемся загрузить данные из бинарного файла
    readFile(x, N, file);
    do {
        input(num, "input case: ");
        switch (num) {
            case(1): // Добавление записей
                if (N == 0) {
                    input(N, "input n = ");
                    output(N, "N = ");
                    x = newMassiv(N);
                    setPeople(x, N);
                }
                else {
                    int add;
                    input(add, "input add = ");
                    addRecords(x, N, add);
                    output(N, "N = ");
                    recreateFile(x, N, file);
                }
                break;
            case(2): // Вывод всех записей
                printPeople(x, N);
                createFile(x, N, file);
                break;
            case(3): // Удалить все записи
                deleteRecords(x, N);
                recreateFile(x, N, file);
                break;
            case(4): // Сортировка
                sortRecords(x, N);
                recreateFile(x, N, file);
                break;
            case(5): // Поиск
                findData(x, N);
                break;
            case(6): // Выход с сохранением
                cout << "Exit" << endl;
                printPeople(x, N);
                deleteMassiv(x);
                _getch();
                break;
            default:
                cout << "Wrong choice" << endl;
        }
    } while (num != 6);
}
